# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats which slows down builds.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    puts "Generated.xcconfig must exist. If you're running pod install manually, make sure flutter pub get is executed first."
    exit 1
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  puts "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
  exit 1
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Xcode 16 (runner macos-15): cac plugin FlutterFire cu import umbrella header
  # <Firebase/Firebase.h> (non-modular) ngay trong module cua chinh no -> loi cung
  # "Include of non-modular header inside framework module", CLANG_ALLOW khong du.
  # Thay bang import module rieng le ngay trong nguon plugin (qua ios/.symlinks,
  # du phong: thang thu muc pub-cache), chay moi lan pod install nen luon sach.
  {
    'firebase_messaging' => 'FirebaseMessaging',
    'firebase_remote_config' => 'FirebaseRemoteConfig',
  }.each do |plugin, framework|
    patterns = [
      File.join(__dir__, '.symlinks', 'plugins', plugin, 'ios', '**', '*.{h,m}'),
      File.join(ENV['PUB_CACHE'] || File.expand_path('~/.pub-cache'), 'hosted', 'pub.dev', "#{plugin}-*", 'ios', '**', '*.{h,m}'),
    ]
    patterns.flat_map { |pattern| Dir.glob(pattern) }
            .map { |file| File.realpath(file) }
            .uniq
            .each do |file|
      content = File.read(file)
      next unless content.include?('#import <Firebase/Firebase.h>')

      begin
        File.chmod(0o644, file)
        File.write(file, content.gsub('#import <Firebase/Firebase.h>',
                                      "#import <FirebaseCore/FirebaseCore.h>\n#import <#{framework}/#{framework}.h>"))
        puts "Patched umbrella Firebase import: #{file}"
      rescue => e
        puts "WARNING: could not patch #{file}: #{e}"
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      # Xcode 16 (macos-15 runner) bien loi "non-modular header inside framework
      # module" cua Firebase thanh loi cung — cho phep lai nhu Xcode 15
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      # Cấu hình permission_handler cho iOS
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end